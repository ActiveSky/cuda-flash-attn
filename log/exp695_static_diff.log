+__device__ __forceinline__ void merge_kv8_wave_pair_acc2(
+    float* acc, float own_weight, float peer_weight)
+{
+    const float peer_acc[2] = {
+        raw_wave64_xor32(acc[0]), raw_wave64_xor32(acc[1])};
+    packed_scale(acc, acc, own_weight);
+    packed_scale_acc(acc, peer_acc, peer_weight);
+}
+
+__device__ __forceinline__ void merge_kv8_wave_pair_state(
+    float& m, float& l, float* acc)
+{
+    const float peer_m = raw_wave64_xor32(m);
+    const float peer_l = raw_wave64_xor32(l);
+    const float m_all = fmaxf(m, peer_m);
+    const float own_weight = l > 0.f ? __builtin_exp2f(m - m_all) : 0.f;
+    const float peer_weight = peer_l > 0.f
+        ? __builtin_exp2f(peer_m - m_all) : 0.f;
+    l = l * own_weight + peer_l * peer_weight;
+    m = m_all;
+    merge_kv8_wave_pair_acc2(acc, own_weight, peer_weight);
+    merge_kv8_wave_pair_acc2(acc + 2, own_weight, peer_weight);
+    merge_kv8_wave_pair_acc2(acc + 4, own_weight, peer_weight);
+    merge_kv8_wave_pair_acc2(acc + 6, own_weight, peer_weight);
+}
