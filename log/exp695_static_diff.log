+// exp695: the rebased case9 probe uses the physical 64-lane wave to exchange
+// the first z-state pair.  In dim3(16, 2, 8), lane^32 preserves tx/ty and
+// exchanges the two adjacent z partitions.  Keep this separate from the
+// row-local QK helper: the raw builtin is only valid for this exact wave
+// layout and is enabled by one dedicated kernel template instance.
+__device__ __forceinline__ float raw_wave64_xor32(float value) {
+#if defined(__MACA_ARCH__) && (__MACA_ARCH__ == 1000)
+    union {
+        float f;
+        int i;
+    } bits;
+    bits.f = value;
+    const unsigned source_lane = __lane_id() ^ 32u;
+    bits.i = __builtin_mxc_bsm_bpermute(source_lane << 2, bits.i);
+    return bits.f;
+#else
+    return __shfl_xor_sync(0xffffffffu, value, 32, 64);
+#endif
+}
+
