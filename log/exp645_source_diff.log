+    const int split = blockIdx.y;
+    const int h0 = kv_head * 8 + ty;
+    const int h1 = h0 + 4;
+
+    const int seqlen = cache_seqlens[b];
+    const int full_pages = seqlen / PAGE_TOKENS;
+    int out_split = split;
+    int p_beg;
+    int p_end;
+    if constexpr (FULL_PAGES_ONLY) {
+        p_beg = split * pages_per_split;
