+// exp645: case8's fixed nineteen-page z4 producer uses a direct three-peer
+// fan-in.  Peer accumulators cross the one CTA barrier as normalized BF16
+// payloads, while each row's FP32 (m,l) metadata supplies the LSE mass.  Empty
+// states publish (-Inf, 0) and zero payload, so stale shared bytes are never
+// consumed by the merge.
+__device__ __forceinline__ void store_case8_normalized_z_state(
+    __nv_bfloat162* s_acc,
+    float (*s_md)[2],
+    int row,
+    int tx,
+    float m,
+    float l,
+    const float* acc)
+{
+    __nv_bfloat162* dst =
+        s_acc + row * (HEAD_DIM / 2) + tx * 4;
+    const bool valid = l > 0.f;
+    const float inv_l = valid ? 1.f / l : 0.f;
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        dst[i] = valid
+            ? __floats2bfloat162_rn(
+                acc[2 * i] * inv_l, acc[2 * i + 1] * inv_l)
+            : __floats2bfloat162_rn(0.f, 0.f);
+    }
+    if (tx == 0) {
+        s_md[row][0] = valid ? m : -CUDART_INF_F;
+        s_md[row][1] = valid ? l : 0.f;
+    }
+}
+
+__device__ __forceinline__ void merge_case8_normalized_z_peer(
+    float& m,
+    float& l,
+    float* acc,
+    float peer_m,
+    float peer_l,
+    const __nv_bfloat162* peer_acc)
+{
+    const float m_all = fmaxf(m, peer_m);
+    const bool self_valid = l > 0.f;
+    const bool peer_valid = peer_l > 0.f;
+    const float self_scale = self_valid
+        ? __builtin_exp2f(m - m_all) : 0.f;
+    const float self_weight = l * self_scale;
+    const float peer_weight = peer_valid
+        ? peer_l * __builtin_exp2f(peer_m - m_all) : 0.f;
+    l = self_weight + peer_weight;
+    m = m_all;
+    packed_scale(acc, acc, self_scale);
+    packed_scale(acc + 2, acc + 2, self_scale);
+    packed_scale(acc + 4, acc + 4, self_scale);
+    packed_scale(acc + 6, acc + 6, self_scale);
+    if (peer_valid) {
+        const uint32_t* peer_words =
+            reinterpret_cast<const uint32_t*>(peer_acc);
+        const float peer0[2] = {
+            bf16_lo(peer_words[0]), bf16_hi(peer_words[0])};
+        const float peer1[2] = {
+            bf16_lo(peer_words[1]), bf16_hi(peer_words[1])};
+        const float peer2[2] = {
+            bf16_lo(peer_words[2]), bf16_hi(peer_words[2])};
+        const float peer3[2] = {
+            bf16_lo(peer_words[3]), bf16_hi(peer_words[3])};
+        packed_scale_acc(acc, peer0, peer_weight);
+        packed_scale_acc(acc + 2, peer1, peer_weight);
+        packed_scale_acc(acc + 4, peer2, peer_weight);
+        packed_scale_acc(acc + 6, peer3, peer_weight);
+    }
+}
