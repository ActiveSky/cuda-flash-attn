+// exp702 case14 reducer: normalized BF16 partials carry one FP32 LSE
+// reference in the existing four-byte metadata slot.  Merge those partials
+// directly with exp2(lse-lse_max), retaining the current 257-split ABI and
+// one CTA per output head.
+template <bool BASE2>
+__global__ void __launch_bounds__(128)
+paged_decode_reduce_case14_single_lse_kernel(
+    const float* __restrict__ partial_lse,
+    const float* __restrict__ partial_acc,
+    __nv_bfloat16* __restrict__ out,
+    const int32_t* __restrict__ cache_seqlens,
+    int batch_size,
+    int pages_per_split,
+    int n_split)
+{
+    const int tid = threadIdx.x;
+    const int lane = tid & 31;
+    const int warp = tid >> 5;
+    const int bh = blockIdx.x;
+    const int b = bh >> 5;
+    const int h = bh & 31;
+    const int seqlen = cache_seqlens[b];
+    const int full_pages = seqlen / PAGE_TOKENS;
+    const int live_splits = full_pages > 0
+        ? min(n_split, (full_pages + pages_per_split - 1) / pages_per_split)
+        : ((seqlen & (PAGE_TOKENS - 1)) != 0);
+
+    // A single normalized partial is already the final output.  Empty rows
+    // retain the control's zero-output behavior without reading metadata.
+    if (live_splits <= 1) {
+        if (tid < HEAD_DIM) {
+            if (live_splits == 1) {
+                const int hidx = b * 32 + h;
+                const __nv_bfloat16* partial_bf16 =
+                    reinterpret_cast<const __nv_bfloat16*>(partial_acc);
+                out[(b * 32 + h) * HEAD_DIM + tid] =
+                    partial_bf16[hidx * HEAD_DIM + tid];
+            } else {
+                out[(b * 32 + h) * HEAD_DIM + tid] = __float2bfloat16(0.f);
+            }
+        }
+        return;
+    }
+
+    extern __shared__ float smem[];
+    float* s_w = smem;             // [n_split] LSE merge weights
+    float* s_warp = s_w + n_split; // four warp partial reductions
+
+    const int s0 = tid;
+    const int s1 = tid + 128;
+    const int s2 = tid + 256;
+    float own_lse0 = -CUDART_INF_F;
+    float own_lse1 = -CUDART_INF_F;
+    float own_lse2 = -CUDART_INF_F;
+    if (s0 < live_splits) {
+        own_lse0 = partial_lse[(s0 * batch_size + b) * 32 + h];
+    }
+    if (s1 < live_splits) {
+        own_lse1 = partial_lse[(s1 * batch_size + b) * 32 + h];
+    }
+    if (s2 < live_splits) {
+        own_lse2 = partial_lse[(s2 * batch_size + b) * 32 + h];
+    }
+
+    float lse_local = fmaxf(own_lse0, fmaxf(own_lse1, own_lse2));
+#pragma unroll
+    for (int off = 16; off > 0; off >>= 1) {
+        lse_local = fmaxf(
+            lse_local, __shfl_xor_sync(0xffffffffu, lse_local, off));
+    }
+    if (lane == 0) s_warp[warp] = lse_local;
+    __syncthreads();
+
+    if (warp == 0) {
+        float lse = lane < 4 ? s_warp[lane] : -CUDART_INF_F;
+#pragma unroll
+        for (int off = 16; off > 0; off >>= 1) {
+            lse = fmaxf(lse, __shfl_xor_sync(0xffffffffu, lse, off));
+        }
+        if (lane == 0) s_warp[0] = lse;
+    }
+    __syncthreads();
+    const float lse_max = s_warp[0];
+
+    float weight_local = 0.f;
+    if (s0 < live_splits) {
+        const float weight = own_lse0 > -CUDART_INF_F
+            ? softmax_exp<BASE2>(own_lse0 - lse_max) : 0.f;
+        s_w[s0] = weight;
+        weight_local += weight;
+    }
+    if (s1 < live_splits) {
+        const float weight = own_lse1 > -CUDART_INF_F
+            ? softmax_exp<BASE2>(own_lse1 - lse_max) : 0.f;
+        s_w[s1] = weight;
+        weight_local += weight;
+    }
+    if (s2 < live_splits) {
+        const float weight = own_lse2 > -CUDART_INF_F
+            ? softmax_exp<BASE2>(own_lse2 - lse_max) : 0.f;
+        s_w[s2] = weight;
+        weight_local += weight;
+    }
+#pragma unroll
+    for (int off = 16; off > 0; off >>= 1) {
+        weight_local += __shfl_xor_sync(0xffffffffu, weight_local, off);
+    }
+    if (lane == 0) s_warp[warp] = weight_local;
+    __syncthreads();
+
+    if (warp == 0) {
+        float weight_sum = lane < 4 ? s_warp[lane] : 0.f;
+#pragma unroll
+        for (int off = 16; off > 0; off >>= 1) {
+            weight_sum += __shfl_xor_sync(0xffffffffu, weight_sum, off);
+        }
