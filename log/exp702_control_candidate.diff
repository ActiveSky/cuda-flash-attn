+            const int hidx = (s * batch_size + b) * 32 + h;
+            acc_sum += __bfloat162float(
+                partial_bf16[hidx * HEAD_DIM + tid]) * s_w[s];
+        }
+        out[(b * 32 + h) * HEAD_DIM + tid] =
+            __float2bfloat16(weight_sum > 0.f ? acc_sum / weight_sum : 0.f);
+    }
+}
