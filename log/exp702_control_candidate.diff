+// exp702: BF16-MMA reads the complete shared K tile before applying the
+// logical-token mask.  Zero invalid rows in the case14 fused tail so a legal
+// tail with poisoned padding cannot contaminate QK or the subsequent state.
+__device__ __forceinline__ void issue_case14_tail_headpair_z4_page(
+    const __nv_bfloat16* __restrict__ cache,
+    uint32_t (*smem)[U32_PER_ROW],
+    int pid,
+    int kv_head,
+    int tx,
+    int ty,
+    int tz,
+    int valid_tokens)
+{
+    const int token = tz * 4 + ty;
+    uint32_t* dst = &smem[token][tx * 4];
+    if (token >= valid_tokens) {
+        dst[0] = 0u;
+        dst[1] = 0u;
+        dst[2] = 0u;
+        dst[3] = 0u;
+        return;
+    }
+    const int cache_row =
+        (pid * PAGE_TOKENS * 4 + token * 4 + kv_head) * HEAD_DIM;
+    const uint32_t* src =
+        reinterpret_cast<const uint32_t*>(cache + cache_row) + tx * 4;
+    *reinterpret_cast<uint4*>(dst) = *reinterpret_cast<const uint4*>(src);
+}
