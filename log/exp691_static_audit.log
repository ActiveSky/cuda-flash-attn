+// exp691: case6 has an eight-slot physical partial prefix.  Keep the
+// accumulator order of the rolled path, but make each weight source lane a
+// compile-time row16 broadcast.  The caller guards every slot with the
+// CTA-uniform live-prefix predicate before touching its partial.
+template <int SPLIT>
+__device__ __forceinline__ void group8_static_accumulate_split(
+    float* acc,
+    const float* partial_acc,
+    int batch_size,
+    int batch,
+    int head,
+    int tx,
+    float w_lane)
+{
+    static_assert(SPLIT >= 0 && SPLIT < 8,
+                  "case6 static group8 prefix is exactly eight slots");
+    const int hidx = (SPLIT * batch_size + batch) * 32 + head;
+    const float* src = partial_acc + hidx * HEAD_DIM + tx * 8;
+    const float4 a0 = *reinterpret_cast<const float4*>(src);
+    const float4 a1 = *reinterpret_cast<const float4*>(src + 4);
+    const float w = native_row16_broadcast<SPLIT>(w_lane);
+    const float value[8] = {
+        a0.x, a0.y, a0.z, a0.w, a1.x, a1.y, a1.z, a1.w
+    };
+    packed_scale_acc(acc, value, w);
+    packed_scale_acc(acc + 2, value + 2, w);
+    packed_scale_acc(acc + 4, value + 4, w);
+    packed_scale_acc(acc + 6, value + 6, w);
+}
+
 // Group eight query heads per CTA.  Sixteen tx lanes cooperate on one head's
 // split metadata, while each lane owns eight adjacent output dimensions.  This
 // retains one exponential per (head, split) but cuts reducer CTA count by 8x.
