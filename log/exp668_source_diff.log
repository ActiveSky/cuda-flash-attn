+// exp668: V-next is produced into the K half after QK retires K-current.
+// K-next remains the existing scalar lookahead and is published into the
+// V half after PV; the two shared-half roles then swap for the next page.
+// This leaves one V token outstanding across current PV and next-page QK.
+__device__ __forceinline__ BsmToken128
+issue_case13_kv8_headpair_z8_tokenized_bsm_page(
+    const __nv_bfloat16* __restrict__ cache,
+    uint32_t (*smem)[U32_PER_ROW],
+    int pid, int kv_head, int tx, int ty, int tz)
+{
+    const int token = tz * 2 + ty;
+    const int cache_row =
+        (pid * PAGE_TOKENS * 8 + token * 8 + kv_head) * HEAD_DIM;
+    const uint32_t* src =
+        reinterpret_cast<const uint32_t*>(cache + cache_row) + tx * 4;
+    uint32_t* dst = &smem[token][tx * 4];
+#if XPUOJ_HAS_MCFLASHINFER_BSM
+    return memcpy_async_pred<16, MACA_ICMP_EQ>(
+        dst, const_cast<uint32_t*>(src), 1, 1);
+#else
+    *reinterpret_cast<uint4*>(dst) = *reinterpret_cast<const uint4*>(src);
+    return {};
+#endif
+}
+
+template <bool V_DEAD_HALF_TOKEN_BSM>
+struct Case13VTokenState;
+
+template <>
+struct Case13VTokenState<false> {};
+
+template <>
+struct Case13VTokenState<true> {
+    BsmToken128 token{};
+    bool pending = false;
+};
