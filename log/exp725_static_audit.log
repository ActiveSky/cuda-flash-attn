// exp725: case2's exact one-token rows use a distinct V memory consumer:
// load one aligned 16-byte V chunk directly into a native register vector and
// publish that raw BF16 payload with the matching native global store.  The
// specialization is deliberately disabled for every other dispatch.
using XpuojCase2NativeU4 = __NATIVE_VECTOR__(4, uint32_t);

__device__ __forceinline__ XpuojCase2NativeU4
xpuoj_case2_native_ldg_b128(const void* src)
{
    return __builtin_mxc_ldg_b128(
        const_cast<void*>(src), 0, -1, true, true, false, false);
}

__device__ __forceinline__ void
xpuoj_case2_native_stg_b128(void* dst, XpuojCase2NativeU4 value)
{
    __builtin_mxc_stg_b128_predicator(
        reinterpret_cast<XpuojCase2NativeU4*>(dst), 0, value,
        true, false, false, true, 1, MACA_ICMP_EQ);
}

