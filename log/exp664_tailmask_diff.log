+// exp664: fused-tail PV must mirror the loader guard above.  In particular,
+// token_base+1 may be padding on an odd tail partition; do not even touch the
+// shared V row unless that token is valid.
+template <int HEAD1_LANE = 8>
+__device__ __forceinline__ void exp664_case13_tail_two_token_pv(
+    float owned_score,
+    float m_new0,
+    float m_new1,
+    uint32_t (*s_v)[U32_PER_ROW],
+    int token_base,
+    int tail_tokens,
+    int tx,
+    float& l0,
+    float& l1,
+    float* acc0,
+    float* acc1)
+{
+    static_assert(HEAD1_LANE == 2 || HEAD1_LANE == 4 || HEAD1_LANE == 8,
+                  "head1 owner must start at lane 2, 4 or 8");
+    if (token_base < tail_tokens) {
+        const float owned_exp_arg =
+            owned_score - ((tx & HEAD1_LANE) ? m_new1 : m_new0);
+        const float owned_weight = __builtin_exp2f(owned_exp_arg);
+        const float w0 = native_row16_broadcast<0>(owned_weight);
+        const float w1 = native_row16_broadcast<HEAD1_LANE>(owned_weight);
+        l0 += w0;
+        l1 += w1;
+        const uint4 vpack = *reinterpret_cast<const uint4*>(
+            &s_v[token_base][tx * 4]);
+        pv_two_heads_same_v(acc0, acc1, vpack, w0, w1);
+    }
+    if (token_base + 1 < tail_tokens) {
+        const float owned_exp_arg =
+            owned_score - ((tx & HEAD1_LANE) ? m_new1 : m_new0);
+        const float owned_weight = __builtin_exp2f(owned_exp_arg);
+        const float w0 = native_row16_broadcast<1>(owned_weight);
+        const float w1 = native_row16_broadcast<HEAD1_LANE + 1>(owned_weight);
+        l0 += w0;
+        l1 += w1;
+        const uint4 vpack = *reinterpret_cast<const uint4*>(
+            &s_v[token_base + 1][tx * 4]);
+        pv_two_heads_same_v(acc0, acc1, vpack, w0, w1);
+    }
+}
