+// exp644: case12's eight z partitions are paired inside their physical
+// 64-lane waves before the cross-wave state fan-in.  This is the exact raw
+// FP32 exchange validated by exp525; the even z partition consumes the odd
+// peer and retains the merged state in its own registers.
+__device__ __forceinline__ float raw_wave64_xor32(float value) {
+#if defined(__MACA_ARCH__) && (__MACA_ARCH__ == 1000)
+    union {
+        float f;
+        int i;
+    } bits;
+    bits.f = value;
+    const unsigned source_lane = __lane_id() ^ 32u;
+    bits.i = __builtin_mxc_bsm_bpermute(source_lane << 2, bits.i);
+    return bits.f;
+#else
+    return __shfl_xor_sync(~0ull, value, 32, 64);
+#endif
+}
+
+__device__ __forceinline__ void merge_case13_intrawave_acc2(
+    float* acc, float own_weight, float peer_weight, bool consume_peer)
+{
+    const float peer0 = raw_wave64_xor32(acc[0]);
+    const float peer1 = raw_wave64_xor32(acc[1]);
+    if (consume_peer) {
+        packed_scale(acc, acc, own_weight);
+        acc[0] = fmaf(peer0, peer_weight, acc[0]);
+        acc[1] = fmaf(peer1, peer_weight, acc[1]);
+    }
+}
+
+__device__ __forceinline__ void merge_case13_intrawave_state(
+    float& m, float& l, float* acc, bool consume_peer)
+{
+    const float peer_m = raw_wave64_xor32(m);
+    const float peer_l = raw_wave64_xor32(l);
+    float own_weight = 0.f;
+    float peer_weight = 0.f;
+    if (consume_peer) {
+        const float m_all = fmaxf(m, peer_m);
+        own_weight = l > 0.f ? __builtin_exp2f(m - m_all) : 0.f;
+        peer_weight = peer_l > 0.f
+            ? __builtin_exp2f(peer_m - m_all) : 0.f;
+        l = l * own_weight + peer_l * peer_weight;
+        m = m_all;
+    }
+    merge_case13_intrawave_acc2(acc, own_weight, peer_weight, consume_peer);
+    merge_case13_intrawave_acc2(
+        acc + 2, own_weight, peer_weight, consume_peer);
+    merge_case13_intrawave_acc2(
+        acc + 4, own_weight, peer_weight, consume_peer);
+    merge_case13_intrawave_acc2(
+        acc + 6, own_weight, peer_weight, consume_peer);
+}
