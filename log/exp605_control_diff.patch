+// exp605: case12's z8 physical wave pairs ty=0/1 at the same tx and z-pair.
+// Consume one token at a time so the V register payload can be overwritten by
+// the peer payload before the next-page V load.  This preserves the existing
+// score ownership and head broadcasts while avoiding a current+next or
+// own+peer two-payload live range.
+template <int TOKEN>
+__device__ __forceinline__ void case13_headpair_one_token_pv_direct(
+    const uint4& vpack,
+    float owned_weight,
+    float& l0,
+    float& l1,
+    float* acc0,
+    float* acc1)
+{
+    static_assert(TOKEN == 0 || TOKEN == 1,
+                  "direct-V token must be one of the two z8 tokens");
+    const float w0 = TOKEN == 0
+        ? native_row16_broadcast<0>(owned_weight)
+        : native_row16_broadcast<1>(owned_weight);
+    const float w1 = TOKEN == 0
+        ? native_row16_broadcast<4>(owned_weight)
+        : native_row16_broadcast<5>(owned_weight);
+    l0 += w0;
+    l1 += w1;
+    pv_two_heads_same_v(acc0, acc1, vpack, w0, w1);
+}
+
+// The case12 dim3(16,2,8) mapping is
+// lane=(tz&1)*32 + ty*16 + tx.  Thus lane^16 selects the other ty in the
+// same physical 64-lane wave and preserves both tx and the adjacent-z pair.
+// Exchange the four words in place only after own-token PV has retired; this
+// deliberately avoids keeping current own and peer V vectors live together.
+__device__ __forceinline__ void case13_direct_v_peer_inplace(uint4& vpack)
+{
+#if defined(__MACA_ARCH__) && (__MACA_ARCH__ == 1000)
+    const unsigned peer_lane = __lane_id() ^ 16u;
+    vpack.x = __builtin_mxc_bsm_bpermute(peer_lane << 2, vpack.x);
+    vpack.y = __builtin_mxc_bsm_bpermute(peer_lane << 2, vpack.y);
+    vpack.z = __builtin_mxc_bsm_bpermute(peer_lane << 2, vpack.z);
+    vpack.w = __builtin_mxc_bsm_bpermute(peer_lane << 2, vpack.w);
+#else
+    (void)vpack;
+#endif
+}
