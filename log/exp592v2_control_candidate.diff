+        bf16_lo(qpack0.z), bf16_hi(qpack0.z),
+        bf16_lo(qpack0.w), bf16_hi(qpack0.w)};
+    float q1[8] = {
+        bf16_lo(qpack1.x), bf16_hi(qpack1.x),
+        bf16_lo(qpack1.y), bf16_hi(qpack1.y),
+        bf16_lo(qpack1.z), bf16_hi(qpack1.z),
